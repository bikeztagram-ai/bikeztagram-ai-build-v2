{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "source", "priorities", "blockers", "guardrails"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string" },
    "model": { "type": ["string", "null"] },
    "summary": { "type": "string" },
    "priorities": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "priority", "objective", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "priority": { "type": "number", "minimum": 0, "maximum": 100 },
          "objective": { "type": "string", "minLength": 10 },
          "rationale": { "type": "string", "minLength": 10 },
          "acceptance": { "type": "array", "maxItems": 5, "items": { "type": "string" } },
          "likelyFiles": { "type": "array", "items": { "type": "string" } },
          "risk": { "enum": ["low", "medium", "high"] }
        }
      }
    },
    "blockers": { "type": "array", "maxItems": 5 },
    "guardrails": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } },
    "nextQuestion": { "type": "string" }
  }
}
