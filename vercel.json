{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dev": false,
      "parallel/creative-engine-runtime-05": false
    }
  },
  "rewrites": [
    {
      "source": "/api/analyse-library",
      "destination": "/api/analyse-library-fixed"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/"
    }
  ]
}
